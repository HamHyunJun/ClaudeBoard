{
  "name": "@claudeboard/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:demo": "CLAUDEBOARD_DEMO=1 tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:demo": "CLAUDEBOARD_DEMO=1 node dist/index.js",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@claudeboard/shared": "workspace:*",
    "@fastify/static": "^8.2.0",
    "@xterm/headless": "^5.5.0",
    "fastify": "^5.6.1",
    "node-pty": "^1.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
